{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "plugins": ["./biome-plugins/no-raw-html.grit"],
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUndeclaredVariables": "error"
      }
    }
  }
}
