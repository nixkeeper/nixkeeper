// The page writes markup only through setHtml and appendHtml (page/markup.js),
// which take only html`` or raw(): text from the data is then always escaped.
// It's for the page's code (page/), but for the file that defines setHtml:
// move setHtml, and the regex below moves with it. Tests fake the DOM and may
// write innerHTML themselves.
language js

or {
  `$el.innerHTML = $value`,
  `$el.innerHTML += $value`,
  `$el.outerHTML = $value`,
  `$el.outerHTML += $value`,
  `$el.insertAdjacentHTML($where, $value)`
} as $write where {
  $filename <: r".*/page/.*\.m?js",
  not $filename <: r".*/page/markup\.js",
  register_diagnostic(span=$write, message="Write markup with setHtml or appendHtml (page/markup.js), which take only html`` or raw(): text from the data is escaped.")
}
